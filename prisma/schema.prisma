// Leads Global ERP — database schema (MySQL / MariaDB via XAMPP).
//
// Design notes
//  • Every business table has `workspace` ("demo" | "live") so fictional sample data can never mix with real records.
//    Every query goes through src/lib/repo (which always filters by workspace).
//  • Human-readable codes (ORD-1001, BD-1001, DL-1001 …) are separate from the numeric primary key.
//  • Stage / status / list values are plain strings validated in code (src/lib/config) so the client can change them
//    without a database migration.
//  • Dates are real DATE columns; links between records are real foreign keys (V6 linked clients by name only).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────── users & infrastructure ─────────────────────────

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  role         String   @default("staff") // md | nitija | staff
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  activity ActivityLog[]
  tasks    Task[]

  @@map("users")
}

/// Running numbers for codes: ORD-1001, BD-1001, DL-1001, WR-101, DW-001 (one row per workspace + kind).
model Counter {
  id        Int    @id @default(autoincrement())
  workspace String @db.VarChar(10)
  kind      String @db.VarChar(30)
  next      Int

  @@unique([workspace, kind])
  @@map("counters")
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  at         DateTime @default(now())
  userId     Int?
  role       String   @default("") @db.VarChar(20)
  entity     String   @default("") @db.VarChar(30)
  recordCode String   @default("") @db.VarChar(40)
  client     String   @default("")
  text       String   @db.Text

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspace, at])
  @@map("activity_log")
}

model ImportRecord {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  file       String
  target     String   @db.VarChar(20)
  added      Int
  duplicates Int
  invalid    Int
  at         DateTime @default(now())
  role       String   @default("") @db.VarChar(20)

  @@index([workspace, at])
  @@map("import_records")
}

// ───────────────────────── sales & orders ─────────────────────────

model Client {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  name       String
  nameKey    String // normalised name, used for the "client names are unique" rule
  sector     String   @default("")
  stage      String   @default("Prospect") @db.VarChar(20) // Active | Prospect
  segment    String   @default("Blue-Collar") @db.VarChar(12) // Blue-Collar | Corporate | Both (V8: companies belong to a division)
  nextAction String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  visits       Visit[]
  demands      DemandLetter[]
  orders       Order[]
  candidates   Candidate[]
  interviews   Interview[]
  warranties   WarrantyCase[]
  credentials  CredentialRecord[]
  serviceTerms ServiceFeeTerm[]
  vacancies    CorporateVacancy[]
  contracts    Contract[]

  @@unique([workspace, nameKey])
  @@map("clients")
}

model Visit {
  id            Int      @id @default(autoincrement())
  workspace     String   @db.VarChar(10)
  clientId      Int
  contact       String   @default("")
  date          DateTime @db.Date
  outcome       String   @db.VarChar(30)
  pipelineStage String   @default("") @db.VarChar(40)
  nextAction    String   @default("")
  salesperson   String   @default("")
  notes         String   @default("") @db.Text
  createdAt     DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([workspace, date])
  @@map("visits")
}

model DemandLetter {
  id               Int       @id @default(autoincrement())
  workspace        String    @db.VarChar(10)
  code             String    @db.VarChar(20) // DL-1001
  clientId         Int
  orderId          Int?
  letterDate       DateTime? @db.Date
  countries        String    @default("")
  trades           String    @default("")
  quantities       String    @default("")
  nationality      String    @default("")
  salaryBenefits   String    @default("")
  signed           String    @default("No") @db.VarChar(3)
  agencyAllocation String    @default("")
  status           String    @default("Received") @db.VarChar(30)
  createdAt        DateTime  @default(now())

  client Client @relation(fields: [clientId], references: [id])
  order  Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([workspace, code])
  @@map("demand_letters")
}

model Order {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  code       String   @db.VarChar(20) // ORD-1001
  clientId   Int
  country    String   @db.VarChar(60)
  trade      String
  qty        Int
  status     String   @default("New Order") @db.VarChar(40)
  agency     String   @default("")
  importKey  String? // duplicate key used by imports (V6 rule)
  sourceFile String?
  sourceRow  Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client        Client              @relation(fields: [clientId], references: [id])
  candidates    Candidate[]
  allocations   AgencyAllocation[]
  demands       DemandLetter[]
  serviceTerms  ServiceFeeTerm[]
  contracts     Contract[]
  allocationsV8 FinanceAllocation[]

  @@unique([workspace, code])
  @@index([workspace, importKey])
  @@map("orders")
}

model AgencyAllocation {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  agency    String
  country   String   @db.VarChar(60)
  orderId   Int
  allocated Int
  status    String   @default("Sourcing") @db.VarChar(40)
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([workspace])
  @@map("agency_allocations")
}

// ───────────────────────── candidates & pipeline ─────────────────────────

model Candidate {
  id         Int       @id @default(autoincrement())
  workspace  String    @db.VarChar(10)
  code       String    @db.VarChar(20) // BD-1001 / NP-1003
  name       String
  passport   String    @default("")
  dupKey     String // V6 duplicate key: passport if present, else name+client (unique per workspace)
  clientId   Int
  orderId    Int?
  country    String    @db.VarChar(60)
  agency     String    @default("")
  trade      String
  status     String    @default("CV Submitted") @db.VarChar(40)
  visaNumber String    @default("")
  qvcDate    DateTime? @db.Date
  flightDate DateTime? @db.Date
  sourceFile String?
  sourceRow  Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client           Client              @relation(fields: [clientId], references: [id])
  order            Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  history          CandidateStage[]
  travel           TravelRecord?
  warranties       WarrantyCase[]
  interviewEntries InterviewEntry[]
  allocationsV8    FinanceAllocation[]

  @@unique([workspace, code])
  @@unique([workspace, dupKey])
  @@index([workspace, status])
  @@index([workspace, clientId])
  @@map("candidates")
}

model CandidateStage {
  id          Int      @id @default(autoincrement())
  candidateId Int
  stage       String   @db.VarChar(40)
  at          DateTime @default(now())
  byRole      String   @default("") @db.VarChar(20)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
  @@map("candidate_stages")
}

model Interview {
  id         Int       @id @default(autoincrement())
  workspace  String    @db.VarChar(10)
  clientId   Int
  method     String    @db.VarChar(30)
  country    String    @db.VarChar(60)
  date       DateTime? @db.Date
  candidates Int       @default(0)
  status     String    @default("Scheduled") @db.VarChar(20)
  createdAt  DateTime  @default(now())

  client  Client           @relation(fields: [clientId], references: [id])
  entries InterviewEntry[]

  @@index([workspace, date])
  @@map("interviews")
}

model TravelRecord {
  id          Int      @id @default(autoincrement())
  workspace   String   @db.VarChar(10)
  candidateId Int      @unique // one travel record per candidate
  ticketBy    String   @default("") @db.VarChar(10)
  flight      String   @default("")
  driverName  String   @default("")
  driverPhone String   @default("")
  step        String   @default("Pending") @db.VarChar(30)
  createdAt   DateTime @default(now())

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([workspace])
  @@map("travel_records")
}

model WarrantyCase {
  id             Int       @id @default(autoincrement())
  workspace      String    @db.VarChar(10)
  code           String    @db.VarChar(20) // WR-101
  division       String    @db.VarChar(10) // Labour | Domestic
  clientId       Int?
  clientLabel    String    @default("") // household / free-text client for domestic cases
  candidateId    Int?
  issue          String
  status         String    @default("Pending") @db.VarChar(30)
  warrantyStart  DateTime? @db.Date
  warrantyExpiry DateTime? @db.Date
  createdAt      DateTime  @default(now())

  client    Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  candidate Candidate? @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@unique([workspace, code])
  @@map("warranty_cases")
}

model DomesticCase {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  code       String   @db.VarChar(20) // DW-001
  customer   String   @default("")
  origin     String   @db.VarChar(60)
  status     String   @default("Customer Enquiry") @db.VarChar(40)
  nextAction String   @default("")
  createdAt  DateTime @default(now())

  // V8: individual sponsor profile (never a company). QID is stored encrypted; only its last characters are kept in clear for masking.
  sponsorType  String    @default("Qatari Citizen") @db.VarChar(30)
  qidCipher    String?   @db.Text
  qidLast      String    @default("") @db.VarChar(6)
  mobile       String    @default("") @db.VarChar(40)
  address      String    @default("")
  category     String    @default("") @db.VarChar(40)
  arrivalDate  DateTime? @db.Date
  handoverDate DateTime? @db.Date
  handoverNote String    @default("")

  account   DomesticAccount?
  payments  ReceivablePayment[]
  refunds   RefundClaim[]
  contracts Contract[]

  @@unique([workspace, code])
  @@map("domestic_cases")
}

// ───────────────────────── registers, finance, intake ─────────────────────────

/// Descriptions only. Passwords / OTPs must never be stored here (a real vault is required — see docs).
model CredentialRecord {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  clientId  Int
  portal    String   @db.VarChar(30)
  record    String
  access    String   @default("Authorized only")
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@map("credential_records")
}

model FinanceEntry {
  id         Int      @id @default(autoincrement())
  workspace  String   @db.VarChar(10)
  date       DateTime @db.Date
  division   String   @db.VarChar(10) // labour | domestic
  direction  String   @db.VarChar(10) // Incoming | Outgoing
  account    String   @db.VarChar(20)
  party      String
  client     String   @default("")
  country    String   @default("") @db.VarChar(60)
  orderRef   String   @default("")
  category   String   @db.VarChar(40)
  amount     Decimal  @db.Decimal(14, 2)
  ref        String   @default("")
  note       String   @default("")
  importKey  String?
  sourceFile String?
  sourceRow  Int?
  createdAt  DateTime @default(now())

  allocations FinanceAllocation[]

  @@index([workspace, date])
  @@index([workspace, importKey])
  @@map("finance_entries")
}

model CvIntakeItem {
  id             Int      @id @default(autoincrement())
  workspace      String   @db.VarChar(10)
  filename       String
  size           Int      @default(0)
  type           String   @default("") @db.VarChar(10)
  source         String   @default("Direct upload") @db.VarChar(30)
  client         String   @default("")
  agency         String   @default("")
  country        String   @default("") @db.VarChar(60)
  status         String   @default("Needs review") @db.VarChar(30)
  note           String   @default("")
  extractedEmail String   @default("")
  extractedPhone String   @default("")
  preview        String   @default("") @db.Text
  receivedAt     DateTime @default(now())

  @@index([workspace, filename, size])
  @@map("cv_intake_items")
}

// ───────────────────────── V8: domestic sponsors, corporate placements, service fees ─────────────────────────
// MONEY TABLES (everything below that holds an amount) are only ever read/written by code that checks the finance permission.

model DomesticAccount {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  caseId    Int      @unique
  agreedFee Decimal  @db.Decimal(14, 2)
  govFees   Decimal  @default(0) @db.Decimal(14, 2)
  notes     String   @default("")
  createdAt DateTime @default(now())

  domesticCase DomesticCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("domestic_accounts")
}

/// One ledger of receipts/payments for the three receivable kinds. Exactly one of the three foreign keys is set.
model ReceivablePayment {
  id               Int      @id @default(autoincrement())
  workspace        String   @db.VarChar(10)
  direction        String   @default("Incoming") @db.VarChar(10)
  date             DateTime @db.Date
  amount           Decimal  @db.Decimal(14, 2)
  currency         String   @default("QAR") @db.VarChar(3)
  account          String   @default("") @db.VarChar(20)
  category         String   @default("") @db.VarChar(30)
  receiptNo        String   @default("") @db.VarChar(40)
  reference        String   @default("")
  note             String   @default("")
  domesticCaseId   Int?
  placementFeeId   Int?
  serviceInvoiceId Int?
  createdById      Int?
  createdAt        DateTime @default(now())

  domesticCase   DomesticCase?      @relation(fields: [domesticCaseId], references: [id], onDelete: Cascade)
  placementFee   PlacementFee?      @relation(fields: [placementFeeId], references: [id], onDelete: Cascade)
  serviceInvoice ServiceFeeInvoice? @relation(fields: [serviceInvoiceId], references: [id], onDelete: Cascade)

  @@index([workspace, date])
  @@map("receivable_payments")
}

/// A refund estimate + decision. Approval only records the decision; nothing is paid out automatically.
model RefundClaim {
  id            Int       @id @default(autoincrement())
  workspace     String    @db.VarChar(10)
  code          String    @db.VarChar(20)
  caseId        Int
  monthsServed  Int
  reason        String    @db.VarChar(60)
  evidence      String    @db.Text
  feePaid       Decimal   @db.Decimal(14, 2)
  govFees       Decimal   @default(0) @db.Decimal(14, 2)
  estimate      Decimal?  @db.Decimal(14, 2)
  ruleVersion   String    @default("") @db.VarChar(80)
  status        String    @default("Pending review") @db.VarChar(30)
  requestedById Int?
  decidedById   Int?
  decidedAt     DateTime?
  decisionNote  String    @default("")
  createdAt     DateTime  @default(now())

  domesticCase DomesticCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([workspace, code])
  @@map("refund_claims")
}

model CorporateVacancy {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  code      String   @db.VarChar(20) // VC-1001
  clientId  Int
  title     String
  category  String   @default("") @db.VarChar(60)
  quantity  Int      @default(1)
  source    String   @default("Local Qatar") @db.VarChar(20)
  status    String   @default("Open") @db.VarChar(20)
  notes     String   @default("")
  createdAt DateTime @default(now())

  client     Client               @relation(fields: [clientId], references: [id])
  placements CorporatePlacement[]

  @@unique([workspace, code])
  @@map("corporate_vacancies")
}

model CorporatePlacement {
  id            Int       @id @default(autoincrement())
  workspace     String    @db.VarChar(10)
  code          String    @db.VarChar(20) // PL-1001
  vacancyId     Int
  candidateName String
  source        String    @default("Local Qatar") @db.VarChar(20)
  country       String    @default("") @db.VarChar(60)
  stage         String    @default("Shortlisted") @db.VarChar(20)
  offerDate     DateTime? @db.Date
  joiningDate   DateTime? @db.Date // CONFIRMED joining date — the fee clock starts here
  notes         String    @default("")
  createdAt     DateTime  @default(now())

  vacancy CorporateVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  fee     PlacementFee?

  @@unique([workspace, code])
  @@map("corporate_placements")
}

model PlacementFee {
  id           Int       @id @default(autoincrement())
  workspace    String    @db.VarChar(10)
  placementId  Int       @unique
  basicSalary  Decimal   @db.Decimal(14, 2)
  basis        String    @db.VarChar(10) // half | one | custom
  feeAmount    Decimal   @db.Decimal(14, 2)
  dueMonths    Int       @default(1) // 1 or 3 calendar months after confirmed joining
  invoiceNo    String    @default("") @db.VarChar(40)
  invoiceDate  DateTime? @db.Date
  creditNote   Decimal   @default(0) @db.Decimal(14, 2)
  creditReason String    @default("")
  note         String    @default("")
  createdAt    DateTime  @default(now())

  placement CorporatePlacement  @relation(fields: [placementId], references: [id], onDelete: Cascade)
  payments  ReceivablePayment[]

  @@map("placement_fees")
}

/// Optional client-paid service charge for blue-collar clients/orders (off unless an agreement enables it).
model ServiceFeeTerm {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  clientId  Int
  orderId   Int?
  enabled   Boolean  @default(false)
  currency  String   @default("USD") @db.VarChar(3)
  basis     String   @default("worker") @db.VarChar(10) // worker | order
  amount    Decimal  @db.Decimal(14, 2)
  trigger   String   @default("Verified arrival") @db.VarChar(30)
  taxable   Boolean  @default(false)
  notes     String   @default("")
  createdAt DateTime @default(now())

  client   Client              @relation(fields: [clientId], references: [id])
  order    Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoices ServiceFeeInvoice[]

  @@map("service_fee_terms")
}

model ServiceFeeInvoice {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  code      String   @db.VarChar(20) // SI-1001
  termId    Int
  invoiceNo String   @default("") @db.VarChar(40)
  date      DateTime @db.Date
  workers   Int      @default(0)
  amount    Decimal  @db.Decimal(14, 2)
  note      String   @default("")
  createdAt DateTime @default(now())

  term     ServiceFeeTerm      @relation(fields: [termId], references: [id], onDelete: Cascade)
  payments ReceivablePayment[]

  @@unique([workspace, code])
  @@map("service_fee_invoices")
}

/// Agency deposits stay UNALLOCATED until the Managing Director approves an explicit allocation.
model FinanceAllocation {
  id             Int       @id @default(autoincrement())
  workspace      String    @db.VarChar(10)
  financeEntryId Int
  orderId        Int?
  candidateId    Int?
  amount         Decimal   @db.Decimal(14, 2)
  note           String    @default("")
  status         String    @default("Proposed") @db.VarChar(20)
  proposedById   Int?
  decidedById    Int?
  decidedAt      DateTime?
  createdAt      DateTime  @default(now())

  entry     FinanceEntry @relation(fields: [financeEntryId], references: [id], onDelete: Cascade)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  candidate Candidate?   @relation(fields: [candidateId], references: [id], onDelete: SetNull)

  @@map("finance_allocations")
}

// ───────────────────────── V8: contracts, tasks, interview attendance ─────────────────────────

model Contract {
  id             Int       @id @default(autoincrement())
  workspace      String    @db.VarChar(10)
  code           String    @db.VarChar(20) // CT-1001
  division       String    @db.VarChar(10) // labour | domestic | corporate
  clientId       Int? // labour / corporate: filed by company
  domesticCaseId Int? // domestic: filed by individual sponsor
  title          String
  agreementType  String    @default("") @db.VarChar(40)
  signedDate     DateTime? @db.Date
  effectiveDate  DateTime? @db.Date
  expiryDate     DateTime? @db.Date
  orderId        Int?
  billingTerms   String    @default("") @db.Text
  warrantyTerms  String    @default("") @db.Text
  notes          String    @default("") @db.Text
  archivedAt     DateTime? // archived contracts are hidden from alerts but never deleted
  createdAt      DateTime  @default(now())

  client       Client?           @relation(fields: [clientId], references: [id])
  domesticCase DomesticCase?     @relation(fields: [domesticCaseId], references: [id])
  order        Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  versions     ContractVersion[]

  @@unique([workspace, code])
  @@index([workspace, expiryDate])
  @@map("contracts")
}

/// Every upload is a NEW version; originals are never overwritten. The file lives encrypted in the storage folder.
model ContractVersion {
  id           Int      @id @default(autoincrement())
  workspace    String   @db.VarChar(10)
  contractId   Int
  version      Int
  filename     String
  mime         String   @default("") @db.VarChar(100)
  size         Int
  sha256       String   @db.VarChar(64)
  storageKey   String   @db.VarChar(120)
  note         String   @default("")
  uploadedById Int?
  uploadedAt   DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([contractId, version])
  @@map("contract_versions")
}

model Task {
  id           Int       @id @default(autoincrement())
  workspace    String    @db.VarChar(10)
  code         String    @db.VarChar(20) // TK-1001
  title        String
  detail       String    @default("") @db.Text
  kind         String    @default("Manual") @db.VarChar(30)
  assigneeId   Int?
  createdById  Int?
  dueDate      DateTime? @db.Date
  priority     String    @default("Normal") @db.VarChar(10)
  status       String    @default("Open") @db.VarChar(10)
  linkedEntity String    @default("") @db.VarChar(30)
  linkedCode   String    @default("") @db.VarChar(40)
  doneAt       DateTime?
  createdAt    DateTime  @default(now())

  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  @@unique([workspace, code])
  @@index([workspace, status, dueDate])
  @@map("tasks")
}

model InterviewEntry {
  id          Int      @id @default(autoincrement())
  workspace   String   @db.VarChar(10)
  interviewId Int
  candidateId Int
  attended    String   @default("") @db.VarChar(5) // Yes | No | (blank = not recorded)
  decision    String   @default("Pending") @db.VarChar(10) // Pending | Selected | Rejected
  note        String   @default("")
  createdAt   DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([interviewId, candidateId])
  @@map("interview_entries")
}

/// Overseas recruitment agencies (register). Allocations and candidates still refer to an agency by name.
model Agency {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  name      String
  nameKey   String
  country   String   @default("") @db.VarChar(60)
  contact   String   @default("")
  phone     String   @default("") @db.VarChar(40)
  email     String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())

  @@unique([workspace, nameKey])
  @@map("agencies")
}

/// Extra choices added in the app for lists that were fixed in the config file (domestic worker categories, corporate job categories).
model ListItem {
  id        Int      @id @default(autoincrement())
  workspace String   @db.VarChar(10)
  kind      String   @db.VarChar(30)
  value     String   @db.VarChar(80)
  createdAt DateTime @default(now())

  @@unique([workspace, kind, value])
  @@map("list_items")
}

/// Encrypted contract files when STORAGE_DRIVER=db (the default on Vercel, which has no persistent disk). Content is AES-256-GCM ciphertext.
model StoredFile {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(190)
  data      Bytes
  size      Int
  createdAt DateTime @default(now())

  @@map("stored_files")
}

/// Level-wise access per role and module (none / view / edit / full). Missing rows use the defaults in src/lib/access-config.ts.
model RoleAccess {
  id     Int    @id @default(autoincrement())
  role   String @db.VarChar(10)
  module String @db.VarChar(30)
  level  String @db.VarChar(5)

  @@unique([role, module])
  @@map("role_access")
}
