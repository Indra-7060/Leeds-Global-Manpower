# XAMPP MariaDB (default XAMPP user "root" has an empty password).
# Database: leeds_global_manpower (create it empty in phpMyAdmin first, then run npm run db:migrate and npm run db:seed).
DATABASE_URL="mysql://root:@localhost:3306/leeds_global_manpower"

# Secret used to sign login cookies. Replace with a long random value before anyone else uses the app.
SESSION_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"
