# XAMPP MariaDB (default XAMPP user "root" has an empty password).
# Database: leeds_global_manpower (create it empty in phpMyAdmin first, then run npm run db:migrate and npm run db:seed).
DATABASE_URL="mysql://root:@localhost:3306/leeds_global_manpower"

# Secret used to sign login cookies. Replace with a long random value before anyone else uses the app.
SESSION_SECRET="dev-only-change-me-to-a-long-random-string-0123456789"

# Optional. 32 random bytes, base64 (encrypts sponsor QIDs and uploaded contract files). BACK IT UP — without it those cannot be read again.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# DATA_KEY=""
# Where uploaded contract files are kept (default ./storage, git-ignored).
# STORAGE_DIR="./storage"

# ── Hosting on Vercel (see docs/09_Vercel_Deployment.md) ──
# Hosted MySQL needs TLS: add ?ssl=true to DATABASE_URL, e.g.
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE?ssl=true"
# Contract files: "disk" (local folder) or "db" (encrypted bytes in MySQL). Vercel uses "db" automatically.
# STORAGE_DRIVER="db"
# Connections per server instance (default 5 locally, 2 on Vercel).
# DB_POOL="2"
